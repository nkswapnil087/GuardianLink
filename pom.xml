<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Basic project coordinates -->
    <groupId>com.guardianlink</groupId>
    <artifactId>guardianlink-app</artifactId>
    <version>1.0-SNAPSHOT</version>

    <name>GuardianLink JavaFX App</name>
    <description>NGO Child Welfare &amp; Sponsorship Management System (JavaFX)</description>

    <!-- Java and JavaFX versions -->
    <properties>
        <!-- Adjust this if you use a different JDK version (e.g., 21) -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- JavaFX version and platform (Windows for you) -->
        <javafx.version>17.0.2</javafx.version>
        <javafx.platform>win</javafx.platform>
    </properties>

    <dependencies>
        <!-- JavaFX controls -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>

        <!-- JavaFX FXML (if you ever use FXML) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
            <classifier>${javafx.platform}</classifier>
        </dependency>
    </dependencies>

    <build>
        <!-- Tell Maven that your sources are directly under src/ (not src/main/java) -->
        <sourceDirectory>src</sourceDirectory>

        <plugins>
            <!-- Compile with the chosen Java version -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- JavaFX Maven plugin to run the app -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <!-- Your main JavaFX Application subclass -->
                    <mainClass>com.guardianlink.GuardianLinkApp</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
